<!-- csproj ≈ pom.xml：SDK 风格项目文件。Sdk="Microsoft.NET.Sdk.Web" = Web 应用（含 Kestrel、静态文件等） -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- TargetFramework ≈ Java 的 <release>：net10.0 = .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- PackageReference ≈ Maven <dependency>：NuGet 包名 + 版本 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <!-- Pomelo 是社区维护的 MySQL EF Core provider（≈ Hibernate 的 MySQL Dialect） -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <!-- PrivateAssets=all ≈ Maven <scope>provided</scope>：只在开发/设计时使用，不随发布传递 -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
