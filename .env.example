# Prefer scripts/configure.sh to generate random local-only values.
DB_ROOT_PASSWORD=replace-with-random-local-value
DB_PASSWORD=replace-with-another-random-local-value
DEMO_PASSWORD=replace-with-at-least-12-characters
INTEGRATION_TOKEN=replace-with-random-shared-receiver-key

# Optional appointment agent (backend only; never use a VITE_ key).
KIMI_API_KEY=
Agent__BaseUrl=https://api.moonshot.cn/v1
Agent__Model=kimi-k2.6
Agent__DemoEnabled=false
